# Copy to .env.local and fill in from your Supabase project:
# Settings → API Keys (the Connect dialog in the top bar has both too).
#
# The publishable key is safe to expose — it ships to the browser by design, and
# row-level security is what protects your data. Never put a secret key here.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
